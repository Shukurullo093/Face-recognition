# ===== Application =====
APP_NAME="Face Recognition System"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=false

# ===== Database =====
POSTGRES_USER=face
POSTGRES_PASSWORD=face_password
POSTGRES_DB=facedb
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ===== Security =====
# openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_super_secret_key_min_32_chars_long_0000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT=100/minute

# ===== Recognition models =====
DETECTOR_MODEL_PATH=./models/scrfd_2.5g_bnkps.onnx
ARCFACE_MODEL_PATH=./models/arcface_r100.onnx
# GPU (Docker / CUDA host). For CPU-only local dev use: CPUExecutionProvider
ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
DETECTION_INPUT_SIZE=640
DETECTION_THRESHOLD=0.5
DETECTION_NMS_THRESHOLD=0.4
RECOGNITION_THRESHOLD=0.35       # cosine similarity match cutoff
MIN_FACE_SIZE=40

# ===== Search =====
SEARCH_TOP_K=10
HNSW_EF_SEARCH=80

# ===== Bulk import =====
IMPORT_BATCH_SIZE=32
IMPORT_MAX_WORKERS=4
